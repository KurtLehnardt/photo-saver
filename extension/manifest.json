{
  "manifest_version": 3,
  "name": "FrameFlow for iCloud Photos",
  "version": "1.0.0",
  "description": "Turn your iCloud Photos into a beautiful slideshow with Ken Burns effect, transitions, and shuffle.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.icloud.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.icloud.com/photos/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
